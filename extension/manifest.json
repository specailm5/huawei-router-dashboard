{
  "manifest_version": 3,
  "name": "Huawei Router Dashboard",
  "version": "1.0.0",
  "description": "Read and control a Huawei 4G/5G router from a local page.",
  "key": "",
  "host_permissions": ["http://*/*"],
  "action": { "default_title": "Huawei Router Dashboard" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"]
}
